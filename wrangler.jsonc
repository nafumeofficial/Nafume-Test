{
  // NAFUME on Cloudflare: static site + /api Worker + D1 database + cron.
  // Setup:  see CLOUDFLARE-SETUP.md
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nafume",
  "main": "worker/index.mjs",
  "workers_dev": true,
  // GO-LIVE (do this last, after the Razorpay live keys are set): delete the old
  // "www" CNAME in Cloudflare DNS, then uncomment and run `npx wrangler deploy`.
  // "routes": [{ "pattern": "www.nafume.com", "custom_domain": true }],
  "preview_urls": false,
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "build": { "command": "node scripts/build-cloudflare.js" },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only API calls wake the Worker; every page and file is served straight
    // from Cloudflare's edge.
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nafume",
      // Replace with the id printed by:  npx wrangler d1 create nafume
      "database_id": "0996fe6d-0969-4d8a-93dd-c6b791c9b7d5"
    }
  ],

  // Public, non-secret settings. Secrets (Razorpay, Resend, admin/cron tokens...)
  // are set with `npx wrangler secret put NAME` — never written here.
  "vars": {
    "SITE_URL": "https://www.nafume.com"
  },

  // Daily at 04:00 UTC, same as the Vercel cron it replaces; Cloudflare allows
  // far more often if you want review requests and payment checks faster.
  "triggers": { "crons": ["0 4 * * *"] },

  "observability": { "enabled": true }
}
