# ============================================================================
# NAFUME — Environment Variables
# ============================================================================
# Do NOT commit real values. Add real values in:
#   Vercel Dashboard → Project → Settings → Environment Variables
#   → select both "Production" and "Preview" environments
#   → trigger a new Vercel deployment after adding/changing values
#
# NEVER prefix these with NEXT_PUBLIC_ — they must stay server-side only.
#
# WHAT IS ACTUALLY REQUIRED
#   To take orders at all:   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
#                            RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET
#   Everything else below adds capability (emails, OTP login, the review-request
#   job, admin operations). Anything left blank degrades cleanly and says so —
#   nothing is faked.
# ============================================================================


# ════════════════════════════════════════════════════════════════════════════
#  DATABASE — REQUIRED
# ════════════════════════════════════════════════════════════════════════════
# Postgres, reached over Supabase's REST endpoint (no npm packages needed).
#
# Setup (one time, ~5 minutes):
#   1. Create a free project at https://supabase.com
#   2. Project → SQL Editor → New query → paste ALL of db/schema.sql → Run.
#      The script is idempotent and never drops or truncates existing data,
#      so it is safe to re-run after a schema update.
#   3. Project → Settings → API:
#        SUPABASE_URL                = the "Project URL"  (https://xxxx.supabase.co)
#        SUPABASE_SERVICE_ROLE_KEY   = the "service_role" secret key
#
# ⚠️  The service_role key BYPASSES row-level security. It must never appear in
#     any frontend file, any HTML page, or any client-side JavaScript. Only
#     api/_lib/db.js reads it. Every table has RLS enabled with no policies, so
#     the public anon key can read and write nothing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — force a storage driver. Leave blank in production.
#   "supabase"  use Supabase (the default whenever the two vars above are set)
#   "memory"    in-process store for LOCAL DEVELOPMENT AND TESTS ONLY.
#               Data lives for the lifetime of the process (or in NAFUME_DB_FILE)
#               and is NOT shared between serverless instances. Never set this in
#               production — without it, an unconfigured deployment correctly
#               refuses to take orders rather than silently losing them.
NAFUME_DB_DRIVER=

# Optional — with NAFUME_DB_DRIVER=memory, mirror the store to this JSON file so
# it survives a local restart. Ignored otherwise.
NAFUME_DB_FILE=

# Optional — database request timeout in milliseconds (default 10000).
NAFUME_DB_TIMEOUT_MS=


# ════════════════════════════════════════════════════════════════════════════
#  RAZORPAY — REQUIRED for online payment
# ════════════════════════════════════════════════════════════════════════════
# Get from: https://dashboard.razorpay.com/ → Settings → API Keys
# Use TEST keys (rzp_test_...) first and run the full QA checklist before
# switching to LIVE keys (rzp_live_...). Only change the VALUES in the Vercel
# dashboard to go live — no code change is required.
#
# KEY_ID is the publishable key: api/razorpay/create-order.js returns it to the
# browser, which is exactly what it is for. KEY_SECRET signs and verifies
# payments and must never leave the server.
#
# If these are missing, "Pay Online" reports that it is unavailable and Cash on
# Delivery continues to work.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# STRONGLY RECOMMENDED — secret for /api/razorpay/webhook.
#
# Without it, an order is only marked paid when the customer's browser makes it
# back to /api/razorpay/verify-payment. If they pay and then close the tab, lose
# signal, or the browser is killed, Razorpay has their money and the order sits
# `pending` until someone reconciles it by hand.
#
# The webhook fixes that: Razorpay tells the server directly, independently of
# the browser.
#
# Setup:
#   Razorpay Dashboard → Settings → Webhooks → Add New Webhook
#     URL     https://<your-domain>/api/razorpay/webhook
#     Secret  the same value you put here
#     Events  payment.captured
#
# With this unset the endpoint refuses every request (503) — it is never open.
RAZORPAY_WEBHOOK_SECRET=


# ════════════════════════════════════════════════════════════════════════════
#  EMAIL (Resend) — optional but strongly recommended
# ════════════════════════════════════════════════════════════════════════════
# Powers: order confirmation to the customer, the order alert to your team,
# the popup discount code, the quiz result, and post-delivery review requests.
#
# WITHOUT a key nothing breaks and nothing is faked: every message is still
# written to the `outbound_messages` table with status 'queued', endpoints
# report `emailed: false` honestly, and the discount/quiz result are shown on
# screen instead. Adding the key later lets those queued rows be delivered.
#
# Setup:
#   1. Sign up at https://resend.com (free tier: 100 emails/day, 3000/month).
#   2. Dashboard → API Keys → create a key → paste below.
#   3. Without a verified domain, Resend's sandbox sender (onboarding@resend.dev)
#      can only deliver to YOUR OWN Resend account email. To email real
#      customers you MUST verify a sending domain under Resend → Domains and
#      set the two FROM addresses below to an address on that domain.
RESEND_API_KEY=

# Where internal order-alert emails go. Defaults to nafume.official@gmail.com.
ORDER_NOTIFY_EMAIL_TO=

# Verified sender for INTERNAL notifications (see the domain note above).
# Defaults to Resend's sandbox address — fine for testing, not for production.
ORDER_NOTIFY_EMAIL_FROM=

# Verified sender for CUSTOMER-facing email (order confirmations, discount
# codes, review requests). Falls back to ORDER_NOTIFY_EMAIL_FROM if blank.
# Example: NAFUME <orders@nafume.com>
CUSTOMER_EMAIL_FROM=


# ════════════════════════════════════════════════════════════════════════════
#  SITE URL — recommended
# ════════════════════════════════════════════════════════════════════════════
# Absolute base URL, no trailing slash. Used to build the links inside emails
# (order confirmation, "write a review"). Without it those emails still send,
# but the review-request link will be relative and therefore unusable.
# Example: https://www.nafume.com
SITE_URL=


# ════════════════════════════════════════════════════════════════════════════
#  MSG91 OTP — optional (phone sign-in)
# ════════════════════════════════════════════════════════════════════════════
# Get from: https://msg91.com/ → Dashboard → API Keys
# Without these, the account page's password sign-in still works; only the
# one-time-code option reports that it is unavailable.
MSG91_AUTH_KEY=

# DLT-approved OTP template ID from MSG91 → Templates.
# Your template MUST contain the ##OTP## placeholder. Suggested text:
#   "{#var#} is your NAFUME verification code. It is valid for 5 minutes. Do not share it with anyone."
MSG91_TEMPLATE_ID=

# DLT-approved Sender ID / Header from MSG91 → Sender IDs (e.g. NAFUME)
MSG91_SENDER_ID=

# OTP behaviour (optional — defaults shown)
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SEND_ATTEMPTS=3
OTP_MAX_VERIFY_ATTEMPTS=5


# ════════════════════════════════════════════════════════════════════════════
#  ADMIN + SCHEDULED JOBS
# ════════════════════════════════════════════════════════════════════════════
# Bearer token for /api/admin/orders — the endpoint staff use to record
# shipping and DELIVERY DATES. Setting a delivery date is what makes a post-
# delivery review request become due, so this is required for the review system
# to do anything.
#
# Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# With this unset the admin endpoint refuses EVERY request — it is never open
# by default.
ADMIN_API_TOKEN=

# Secret for the scheduled jobs. Vercel Cron automatically sends
# "Authorization: Bearer <CRON_SECRET>" once this is set on the project, so the
# cron entry in vercel.json needs no extra configuration.
#
# vercel.json runs ONE daily job, /api/jobs/maintenance, which calls all three:
#   /api/jobs/review-requests     queue post-delivery review requests
#   /api/jobs/reconcile-payments  find payments neither the browser nor the
#                                 webhook reported, and repair those orders
#   /api/jobs/drain-outbox        deliver messages queued while a provider was
#                                 unavailable (e.g. before RESEND_API_KEY existed)
# They are combined because Vercel's Hobby plan allows only 2 daily crons; on
# Pro you can schedule them separately (see docs/deployment-checklist.md).
#
# With neither CRON_SECRET nor ADMIN_API_TOKEN set, every job refuses to run
# rather than exposing an open endpoint that could be used to trigger mass email.
CRON_SECRET=

# Days after the recorded delivery date before a review request becomes due.
# Default 5.
REVIEW_REQUEST_DELAY_DAYS=5


# ════════════════════════════════════════════════════════════════════════════
#  INSTAGRAM FEED — optional
# ════════════════════════════════════════════════════════════════════════════
# Long-lived Instagram Basic Display / Graph API token for the homepage feed.
# Without it the feed falls back to the bundled product images.
INSTAGRAM_ACCESS_TOKEN=


# ════════════════════════════════════════════════════════════════════════════
#  NOT CONFIGURED — WhatsApp marketing/broadcast
# ════════════════════════════════════════════════════════════════════════════
# There is deliberately NO WhatsApp provider integration in this repo. Consent
# is captured and stored correctly (marketing_consent table + the
# whatsapp_broadcast_audience view), but nothing sends WhatsApp messages, and
# no code claims to. To add one, implement a provider in
# api/_lib/messaging.js (whatsappConfigured() currently returns false) and only
# ever send to rows returned by the whatsapp_broadcast_audience view.
# See docs/customer-data-system.md.
