{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/server/:path*",            "destination": "/404",          "permanent": false },
    { "source": "/api/index.js",             "destination": "/404",          "permanent": false },
    { "source": "/db/:path*",                "destination": "/404",          "permanent": false },
    { "source": "/test/:path*",              "destination": "/404",          "permanent": false },
    { "source": "/docs/:path*",              "destination": "/404",          "permanent": false },
    { "source": "/:file(.+\\.(?:md|sql))",   "destination": "/404",          "permanent": false },
    { "source": "/index.html",               "destination": "/",             "permanent": true },
    { "source": "/pages/guides/index.html",  "destination": "/pages/guides", "permanent": true },
    { "source": "/pages/guides/index",       "destination": "/pages/guides", "permanent": true },
    { "source": "/pages/:section/:page.html","destination": "/pages/:section/:page", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)",              "destination": "/api?path=$1" },
    { "source": "/pages/guides",             "destination": "/pages/guides/index.html" },
    { "source": "/pages/:section/:page",     "destination": "/pages/:section/:page.html" }
  ],
  "crons": [
    { "path": "/api/jobs/maintenance", "schedule": "0 4 * * *" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ]
}
